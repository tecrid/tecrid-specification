{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecrid/tecrid-specification/v0.1.0/schema/credential-issuance.schema.json",
  "title": "TECRID credential issuance input",
  "description": "Input accepted for issuance of a signed Test Evidence Credential. Server authorization and issuer-scope checks are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sampleName", "publish", "proof", "results"],
  "properties": {
    "sampleName": { "type": "string", "minLength": 1, "maxLength": 180 },
    "productSku": { "type": "string", "minLength": 1, "maxLength": 100 },
    "lotNumber": { "type": "string", "minLength": 1, "maxLength": 120 },
    "matrix": { "type": "string", "minLength": 1, "maxLength": 120 },
    "method": { "type": "string", "minLength": 1, "maxLength": 160 },
    "submittingParty": { "type": "string", "minLength": 1, "maxLength": 160 },
    "collectedAt": { "$ref": "#/$defs/dateTimeText" },
    "receivedAt": { "$ref": "#/$defs/dateTimeText" },
    "testedAt": { "$ref": "#/$defs/dateTimeText" },
    "releasedAt": { "$ref": "#/$defs/dateTimeText" },
    "visibility": { "type": "string", "enum": ["public", "controlled"], "default": "public" },
    "publish": { "const": true },
    "sourceDocument": { "$ref": "#/$defs/sourceDocument" },
    "proof": { "$ref": "#/$defs/proof" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "dateTimeText": { "type": "string", "minLength": 1, "maxLength": 40 },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "filename"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "filename": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reportNumber": { "type": "string", "minLength": 1, "maxLength": 120 },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 120 },
        "intakeId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "issuanceBasis": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1, "maxLength": 180 },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyte", "resultText", "unit"],
      "properties": {
        "analyte": { "type": "string", "minLength": 1, "maxLength": 100 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 12 },
        "resultText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "numericValue": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "loqText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "method": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
